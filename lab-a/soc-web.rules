# SOC-WEB rules v0.1. Indicators, not proof of database compromise.
alert http any any -> any any (msg:"Possible SQL injection UNION SELECT in HTTP URI"; flow:established,to_server; http.uri; content:"union"; nocase; fast_pattern; pcre:"/\bunion(?:\s|\+)+(?:all(?:\s|\+)+|distinct(?:\s|\+)+)?select\b/i"; classtype:web-application-attack; sid:9900101; rev:1;)
alert http any any -> any any (msg:"Possible SQL injection UNION SELECT in HTTP request body"; flow:established,to_server; http.request_body; url_decode; content:"union"; nocase; fast_pattern; pcre:"/\bunion\s+(?:all\s+|distinct\s+)?select\b/i"; classtype:web-application-attack; sid:9900102; rev:1;)
