<!-- SOC-SCENARIO MANAGED v0.4.9: observations, not proof of compromise -->
<group name="soc_lab_scenario,">
  <rule id="119250" level="7">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/opt/soc-lab/DVWA/hackable/uploads/[^\r\n]+\.php$</field>
    <description>SOC lab: PHP file added to DVWA uploads; inspect content and execution evidence.</description>
    <group>soc_lab_fim,php_created,</group>
  </rule>
  <rule id="119251" level="7">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^(/var/lib/soc-lab/fim/|/opt/soc-lab/DVWA/hackable/uploads/)</field>
    <description>SOC lab: monitored exercise artifact modified.</description>
    <group>soc_lab_fim,</group>
  </rule>
  <rule id="119252" level="3">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">^(/var/lib/soc-lab/fim/|/opt/soc-lab/DVWA/hackable/uploads/)</field>
    <description>SOC lab: exercise artifact deleted; this can be operator cleanup.</description>
    <group>soc_lab_fim,</group>
  </rule>
  <rule id="119253" level="3">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/var/lib/soc-lab/fim/</field>
    <description>SOC lab: exercise artifact added. Maliciousness and actor are unknown.</description>
    <group>soc_lab_fim,</group>
  </rule>
  <rule id="119254" level="5">
    <if_sid>4100</if_sid>
    <match type="pcre2">SOC_LAB_FW</match>
    <dstport type="pcre2">^(4444|5555|6666)$</dstport>
    <description>SOC lab: kernel firewall observation for a monitored test port; check policy and counters for disposition.</description>
    <group>soc_lab_firewall,</group>
  </rule>
</group>
